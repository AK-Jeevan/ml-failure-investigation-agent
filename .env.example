# NVIDIA LLM Configuration (Optional; fallback deterministic planner works if omitted)
NVIDIA_API_KEY=
NVIDIA_MODEL=z-ai/glm-5.3
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_PROVIDER_ENABLED=true

# Database Persistence
INVESTIGATION_DB=data/investigations.sqlite3

# API Security (Generate a secure token for bearer authentication)
API_ACCESS_TOKEN=your-secure-bearer-token-here

# Gradio Dashboard Authentication
GRADIO_AUTH_USERNAME=admin
GRADIO_AUTH_PASSWORD=your-secure-dashboard-password-here

# Simulator Settings
SIMULATION_SCENARIO=feature_schema_change
SIMULATION_API_URL=http://127.0.0.1:8001
